# ==========================================
# myManager2 - Environment Variables
# Copy this file to .env for local development (`cp .env.example .env`) and
# fill in real values there. NEVER commit a real .env file - it is already
# excluded in .gitignore. On Vercel, set these under Project Settings ->
# Environment Variables instead of committing them anywhere.
# ==========================================

# --- Database (Neon PostgreSQL) ---
# Set this to your Neon connection string to persist to Postgres. If unset,
# the app falls back to Upstash/Vercel KV (below), then to local JSON files
# under data/*.json for local development. See server/db.js.
DATABASE_URL=

# --- Alternative: Vercel KV / Upstash Redis ---
# Only used if DATABASE_URL is not set.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- AI Voice Entry (OpenAI) ---
# Required for the microphone voice-entry feature: OpenAI Whisper for
# speech-to-text and a Chat Completions model (structured outputs) for
# turning the transcript into a structured job/expense/payment/debt command.
# This key is used server-side only (server/services/ai/*) and is never sent
# to the browser. Without it, the voice button returns a clear "not
# configured" error and every other feature keeps working normally.
OPENAI_API_KEY=

# Optional: override the extraction chat model (defaults to gpt-4o-mini).
# Speech-to-text always uses whisper-1.
OPENAI_EXTRACTION_MODEL=

# --- Server ---
PORT=3001
