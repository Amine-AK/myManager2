# ==========================================
# myManager2 - Environment Variables
# Copy this file to .env for local development (`cp .env.example .env`) and
# fill in real values there. NEVER commit a real .env file - it is already
# excluded in .gitignore. On Vercel, set these under Project Settings ->
# Environment Variables instead of committing them anywhere.
# ==========================================

# --- Database (Neon PostgreSQL) ---
# Set this to your Neon connection string to persist to Postgres. If unset,
# the app falls back to Upstash/Vercel KV (below), then to local JSON files
# under data/*.json for local development. See server/db.js.
DATABASE_URL=

# --- Alternative: Vercel KV / Upstash Redis ---
# Only used if DATABASE_URL is not set.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- AI Voice Entry (Google Gemini) ---
# Required for the microphone voice-entry feature: Gemini transcribes the
# recording directly (it accepts audio as native input) and a second Gemini
# call turns the transcript into a structured job/expense/payment/debt
# command. Get a free API key at https://aistudio.google.com/apikey - note
# this is a SEPARATE credential from a "Gemini Pro" / Google AI Pro consumer
# app subscription; the Gemini API has its own free tier and doesn't need
# that subscription. This key is used server-side only
# (server/services/ai/*) and is never sent to the browser. Without it, the
# voice button returns a clear "not configured" error and every other
# feature keeps working normally.
GEMINI_API_KEY=

# Optional: override the model used for both transcription and extraction.
# Defaults to gemini-flash-latest, a floating alias Google keeps pointed at
# their current Flash-tier model. Pin an exact version (e.g.
# gemini-2.5-flash) instead if you want stability rather than always-latest.
GEMINI_MODEL=

# --- Server ---
PORT=3001
